{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/reports",
      "destination": "/api/combined-reports?route=reports"
    },
    {
      "source": "/api/sales-officers",
      "destination": "/api/combined-reports?route=sales-officers"
    },
    {
      "source": "/api/dashboard-reports",
      "destination": "/api/combined-reports?route=dashboard-reports"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth?route=login"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth?route=me"
    },
    {
      "source": "/api/auth/register",
      "destination": "/api/auth?route=register"
    }
  ]
}