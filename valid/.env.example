# MongoDB Atlas connection URI. Never commit the real URI or credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Absolute path to a Bengali-capable .ttf font for PDF report exports (for example, Noto Sans Bengali).
REPORT_FONT_PATH=


# Random secret of at least 32 characters used to sign secure login sessions.
SESSION_SECRET=

# Comma-separated admin emails permitted to use factory reset, in addition to the first provisioned admin.
SUPER_ADMIN_EMAILS=mostafakamalbg@gmail.com

# Gmail API OAuth credentials. The refresh token must include the gmail.send scope.
GMAIL_USER=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Copy this file to .env, set MongoDB URI and session secret, then run `npm run provision:admin`
# from this project directory in an interactive terminal (repeat for admin #2).
