# MongoDB Atlas connection URI. Never commit the real URI or credentials.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Absolute path to a Bengali-capable .ttf font for PDF report exports (for example, Noto Sans Bengali).
REPORT_FONT_PATH=


# Random secret of at least 32 characters used to sign secure login sessions.
SESSION_SECRET=

# Copy this file to .env, set both values, then run `npm run provision:admin`
# from this project directory in an interactive terminal (repeat for admin #2).
